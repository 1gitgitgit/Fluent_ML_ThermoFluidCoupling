# ========= 10. 逆问题模块：单目标反问题 =========
def inverse_design_tmax(tmax_target, verbose=True):
    # 逆问题的核心思想：
    # 正向：给定(v_inlet, T_inlet) → 预测tmax
    # 逆向：给定tmax上限 → 找满足约束的最小v_inlet
    # 工程场景：老板说散热温度不能超过320K，在这个前提下怎么把泵功压到最低

    constraint = NonlinearConstraint(
        lambda x: surrogate_tmax.predict(x.reshape(1, -1))[0],
        # 约束函数：把代理模型的tmax预测值作为约束
        # x.reshape(1,-1)：differential_evolution传进来的x是一维的
        # 代理模型要求输入是二维的(1,2)，所以reshape一下
        # [0]：predict返回数组，取第一个元素得到标量
        -np.inf, tmax_target
        # 约束范围：-∞ ≤ tmax预测值 ≤ tmax_target
        # 意思是：代理模型预测的tmax必须不超过目标上限
    )

    bounds = [(V_MIN, V_MAX), (T_MIN, T_MAX)]
    # 设计空间边界，和NSGA-II里的xl/xu含义相同

    result = differential_evolution(
        lambda x: x[0],
        # 目标函数：最小化x[0]，也就是最小化v_inlet
        # 为什么不用NSGA-II：这里只有一个目标，单目标用differential_evolution更直接
        bounds,
        constraints=constraint,
        # 告诉优化器必须满足tmax≤target这个约束
        seed=42,
        tol=1e-3,
        # 收敛精度，相邻两次迭代结果差小于0.001就停止
        maxiter=50,
        # 最多迭代50次，防止跑太久
        disp=verbose
        # 是否打印每步迭代信息
    )

    v_opt, T_opt = result.x
    # result.x是优化器找到的最优设计变量[v_inlet, T_inlet]
    # 解包赋值给v_opt和T_opt

    vmax_pred = surrogate_vmax.predict([[v_opt, T_opt]])[0]
    tmax_pred = surrogate_tmax.predict([[v_opt, T_opt]])[0]
    # 用两个代理模型预测这个最优点的性能
    # [[v_opt, T_opt]]：外层列表让输入变成二维(1,2)，符合代理模型要求
    # [0]：取预测结果的第一个元素

    if verbose:
        print(f"\n{'='*50}")
        print(f"逆问题：最小 v_inlet 满足 tmax ≤ {tmax_target:.2f} K")
        print(f"{'='*50}")
        print(f"  最优 v_inlet  = {v_opt:.5f} m/s")
        print(f"  最优 T_inlet  = {T_opt:.2f} K  ({T_opt-273.15:.2f} ℃)")
        print(f"  预测 vmax     = {vmax_pred:.6f} m/s")
        print(f"  预测 tmax     = {tmax_pred:.4f} K  ({tmax_pred-273.15:.2f} ℃)")
        print(f"  优化收敛: {result.success}  (nfev={result.nfev})")
        # result.success：优化是否正常收敛，True才可信
        # result.nfev：优化器总共调用了多少次目标函数，衡量计算量

    return {
        "v_inlet":   v_opt,
        "T_inlet":   T_opt,
        "vmax_pred": vmax_pred,
        "tmax_pred": tmax_pred,
        "success":   result.success
    }
    # 返回字典，方便调用方取用具体字段

# ========= 11. 逆问题模块：可行域可视化 =========
def plot_feasibility_region(tmax_target, save=True):
    # 这个函数回答一个问题：
    # 在整个设计空间里，哪些(v_inlet, T_inlet)组合能满足tmax≤target
    # 工程意义：给工程师看可行域有多大，设计余量够不够

    n_grid = 100
    v_grid = np.linspace(V_MIN, V_MAX, n_grid)
    T_grid = np.linspace(T_MIN, T_MAX, n_grid)
    VV, TT = np.meshgrid(v_grid, T_grid)
    grid_pts = np.column_stack([VV.ravel(), TT.ravel()])
    # 和第5块响应面的做法完全一样
    # 在设计空间撒100×100=10000个网格点，全部喂给代理模型预测

    tmax_pred = surrogate_tmax.predict(grid_pts).reshape(n_grid, n_grid)
    # 预测每个网格点的tmax，reshape回二维方便画图

    fig, ax = plt.subplots(figsize=(8, 6))

    cf = ax.contourf(VV, TT, tmax_pred, levels=30, cmap="RdYlGn_r", alpha=0.7)
    # 填色等高线图，红色=tmax高（不可行），绿色=tmax低（可行）
    # RdYlGn_r：红黄绿色系，_r表示反转，让高值对应红色
    # alpha=0.7：半透明，让下面的细节透出来

    plt.colorbar(cf, ax=ax, label="tmax (K)")

    cs = ax.contour(VV, TT, tmax_pred, levels=[tmax_target],
                    colors="blue", linewidths=2, linestyles="--")
    # 单独画出tmax=target这一条等值线
    # 这条蓝色虚线就是可行域和不可行域的分界线
    # 线左下方满足约束（可行），线右上方不满足（不可行）

    ax.clabel(cs, fmt=f"tmax={tmax_target:.0f}K", fontsize=9)
    # 在等值线上标注数值，告诉工程师这条线代表多少K

    ax.scatter(df["v_inlet"], df["T_inlet"], c="white", s=60,
               edgecolors="black", zorder=5, label="CFD samples")
    # 叠加原始CFD采样点，看有多少样本落在可行域内

    ax.set_xlabel("v_inlet (m/s)")
    ax.set_ylabel("T_inlet (K)")
    ax.set_title(f"Feasibility Region (tmax ≤ {tmax_target:.0f} K)")
    ax.legend(fontsize=9)

    fig.tight_layout()
    if save:
        path = f"{DATA_DIR}\\feasibility_region_tmax{tmax_target:.0f}.png"
        fig.savefig(path, dpi=150)
        print(f"可行域图已保存: {path}")
    plt.show()

# ========= 12. 逆问题模块：Pareto 最近解推荐 =========
def find_nearest_pareto(vmax_target, tmax_target):
    # 使用场景：工程师说"我希望vmax≈0.05，tmax≈320K"
    # 但这个点不一定在Pareto前沿上，甚至可能不可达
    # 这个函数从已有的Pareto前沿里找最接近这个期望的真实可行解

    pareto_path = f"{DATA_DIR}\\pareto_results.csv"
    if not os.path.exists(pareto_path):
        print(f"错误: 未找到 {pareto_path}，请先运行 NSGA-II")
        return None
    # 检查文件是否存在，没有就报错退出
    # 因为这个函数依赖NSGA-II的结果，必须先跑第6块

    pdf = pd.read_csv(pareto_path)
    # 读取Pareto结果表，每行是一个Pareto解

    vmin, vmax = pdf["vmax_pred"].min(), pdf["vmax_pred"].max()
    tmin, tmx  = pdf["tmax_pred"].min(), pdf["tmax_pred"].max()
    # 记录Pareto前沿上vmax和tmax各自的范围
    # 用于后面归一化，把两个目标统一到[0,1]区间

    v_norm = (pdf["vmax_pred"] - vmin) / (vmax - vmin + 1e-12)
    t_norm = (pdf["tmax_pred"] - tmin) / (tmx - tmin + 1e-12)
    # 对Pareto前沿上每个解的目标值做归一化
    # 为什么归一化：vmax是m/s级别很小，tmax是K级别很大
    # 不归一化直接算距离，tmax会完全压制vmax，结果失去意义
    # +1e-12防止分母为零

    tv_norm = (vmax_target - vmin) / (vmax - vmin + 1e-12)
    tt_norm = (tmax_target - tmin) / (tmx - tmin + 1e-12)
    # 把工程师的期望目标值也用同样的方式归一化
    # 这样才能和前沿上的点在同一个尺度下比较距离

    dist = np.sqrt((v_norm - tv_norm)**2 + (t_norm - tt_norm)**2)
    # 计算Pareto前沿上每个点到期望目标的归一化欧氏距离
    # 距离越小说明这个Pareto解越接近工程师的期望

    idx = int(dist.idxmin())
    # idxmin()返回距离最小的那行的索引号
    # 这就是推荐的设计点

    nearest = pdf.loc[idx]
    # 用索引号取出这一行的完整信息

    print(f"\n{'='*50}")
    print(f"Pareto 最近解推荐")
    print(f"{'='*50}")
    print(f"  目标:  vmax_target={vmax_target:.4f},  tmax_target={tmax_target:.2f}")
    print(f"  最近 Pareto 解 (归一化距离={dist[idx]:.4f}):")
    print(f"    v_inlet   = {nearest['v_inlet']:.5f} m/s")
    print(f"    T_inlet   = {nearest['T_inlet']:.2f} K  ({nearest['T_inlet']-273.15:.2f} ℃)")
    print(f"    vmax_pred = {nearest['vmax_pred']:.6f} m/s")
    print(f"    tmax_pred = {nearest['tmax_pred']:.4f} K  ({nearest['tmax_pred']-273.15:.2f} ℃)")

    return {
        "v_inlet":   nearest["v_inlet"],
        "T_inlet":   nearest["T_inlet"],
        "vmax_pred": nearest["vmax_pred"],
        "tmax_pred": nearest["tmax_pred"],
        "distance":  dist[idx],
        # 归一化距离，越小说明推荐结果越接近期望，可以用来评估推荐质量
        "index":     idx
        # 这个解在pareto_results.csv里的行号，方便溯源
    }

