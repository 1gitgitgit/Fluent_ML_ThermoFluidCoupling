# ========= 5. 定义多目标优化问题 =========
class CoolingOptProblem(Problem):
    # (problem)是继承自pybmoo的函数，并且要新加点功能
    """
    设计变量: x[0]=v_inlet (m/s), x[1]=T_inlet (K)
    目标函数: 最小化 vmax 和 tmax（两个都越小越好）
    约束:     无硬约束，边界由 xl/xu 控制
    """
    def __init__(self, model_vmax, model_tmax):
        super().__init__(   #super的意思是对于父类pymoo的problem进行操作
            #用父类的初始化函数，把问题参数传给pymoo让它在内部做好准备
            n_var=2,#设计变量
            n_obj=2,#优化目标
            n_ieq_constr=0,#约束方程个数

            
            xl=np.array([V_MIN, T_MIN]),#下限
            xu=np.array([V_MAX, T_MAX])#上限
        )
        # 把两个代理模型存到对象身上
        self.model_vmax = model_vmax
        self.model_tmax = model_tmax

    def _evaluate(self, x, out, *args, **kwargs):
        f1 = self.model_vmax.predict(x)
        f2 = self.model_tmax.predict(x)
        out["F"] = np.column_stack([f1, f2])
            #n_ieq_constr=2
            # out["F"] → 目标函数值，越小越好（minimize）
            # out["G"] → 不等式约束，必须满足 G <= 0
            # out["H"] → 等式约束，必须满足 H == 0 比如：
            # 约束：G <= 0 才满足
            # g1 = f1 - 5.0   # vmax <= 5.0  →  f1 - 5.0 <= 0
            # g2 = f2 - 400.0  # tmax <= 400K →  f2 - 400.0 <= 0
            # out["G"] = np.column_stack([g1, g2])

problem = CoolingOptProblem(surrogate_vmax, surrogate_tmax)
