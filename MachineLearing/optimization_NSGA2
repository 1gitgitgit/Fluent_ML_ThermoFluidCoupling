    print(f"  v_inlet  = {v:.5f} m/s")
    print(f"  T_inlet  = {T:.2f} K  ({T-273.15:.2f} ℃)")
    print(f"  vmax预测 = {vm:.6f} m/s")
    print(f"  tmax预测 = {tm:.4f} K  ({tm-273.15:.2f} ℃)")

# ========= 9. 可视化 =========
