# ========= 1. 配置 =========
DATA_DIR    = r"D:\VScode\project\2026\demo1\2026-4-5\project_data\data"
SUMMARY_CSV = f"{DATA_DIR}\\summary.csv"

V_MIN, V_MAX = 0.001, 0.1      # m/s
T_MIN, T_MAX = 293.15, 353.15  # K

# ========= 2. 读取summary =========
df = pd.read_csv(SUMMARY_CSV)
print(f"summary数据: {len(df)} 个工况")
print(df.to_string(index=False))

X      = df[["v_inlet", "T_inlet"]].values
y_vmax = df["vmax"].values
y_tmax = df["tmax"].values

# ========= 3. 训练工况级代理模型（5折CV） =========
def train_and_cv(model, X, y, name, k=5):
    """训练 + K折交叉验证，样本少时用全量CV代替train/test split"""
    kf     = KFold(n_splits=k, shuffle=True, random_state=42)
    scores = cross_val_score(model, X, y, cv=kf, scoring="r2")
    print(f"  [{name}] CV R²: {scores.mean():.4f} ± {scores.std():.4f}  "
          f"(各折: {np.round(scores, 4)})")
    model.fit(X, y)   # 最终用全量数据训练
    return model

print("\n" + "="*50)
print("===== 工况代理模型训练 (5折CV, 35个样本) =====")
print("="*50)

print("\n[目标: vmax]")
rf_vmax  = train_and_cv(
    RandomForestRegressor(n_estimators=300, max_depth=10,
                          n_jobs=-1, random_state=42),
    X, y_vmax, "RF-vmax")
lgb_vmax = train_and_cv(
    lgb.LGBMRegressor(n_estimators=300, learning_rate=0.05,
                      num_leaves=31, random_state=42, verbose=-1),
    X, y_vmax, "LGB-vmax")

print("\n[目标: tmax]")
rf_tmax  = train_and_cv(
    RandomForestRegressor(n_estimators=300, max_depth=10,
                          n_jobs=-1, random_state=42),
    X, y_tmax, "RF-tmax")
lgb_tmax = train_and_cv(
    lgb.LGBMRegressor(n_estimators=300, learning_rate=0.05,
                      num_leaves=31, random_state=42, verbose=-1),
    X, y_tmax, "LGB-tmax")

# 根据CV R²自动选择更好的模型
def pick_better(m1, m2, name1, name2, X, y):
    """比较两个已训练模型在全量数据上的R²，返回更好的那个"""
    r2_1 = r2_score(y, m1.predict(X))
    r2_2 = r2_score(y, m2.predict(X))
    if r2_1 >= r2_2:
        print(f"  → 选择 {name1} (R²={r2_1:.4f} vs {name2} R²={r2_2:.4f})")
        return m1, name1
    else:
        print(f"  → 选择 {name2} (R²={r2_2:.4f} vs {name1} R²={r2_1:.4f})")
        return m2, name2

print("\n[自动选择代理模型]")
surrogate_vmax, sname_vmax = pick_better(
    rf_vmax, lgb_vmax, "RF", "LGB", X, y_vmax)
surrogate_tmax, sname_tmax = pick_better(
    rf_tmax, lgb_tmax, "RF", "LGB", X, y_tmax)

print(f"\n>>> vmax代理: {sname_vmax}  |  tmax代理: {sname_tmax}")

# ========= 4. 响应面可视化（验证代理模型合理性） =========
v_grid = np.linspace(V_MIN, V_MAX, 60)
T_grid = np.linspace(T_MIN, T_MAX, 60)
VV, TT = np.meshgrid(v_grid, T_grid)
grid_pts = np.column_stack([VV.ravel(), TT.ravel()])

pred_vmax_grid = surrogate_vmax.predict(grid_pts).reshape(60, 60)
pred_tmax_grid = surrogate_tmax.predict(grid_pts).reshape(60, 60)

fig, axes = plt.subplots(1, 2, figsize=(14, 5))
fig.suptitle("Surrogate Model Response Surface", fontsize=13)

ax = axes[0]
cf = ax.contourf(VV, TT, pred_vmax_grid, levels=25, cmap="coolwarm")
plt.colorbar(cf, ax=ax, label="vmax (m/s)")
ax.scatter(df["v_inlet"], df["T_inlet"], c="white", s=40,
           edgecolors="black", zorder=5, label="CFD samples")
ax.set_xlabel("v_inlet (m/s)")
ax.set_ylabel("T_inlet (K)")
ax.set_title(f"Predicted vmax  [{sname_vmax}]")
ax.legend()

ax = axes[1]
cf = ax.contourf(VV, TT, pred_tmax_grid, levels=25, cmap="jet")
plt.colorbar(cf, ax=ax, label="tmax (K)")
ax.scatter(df["v_inlet"], df["T_inlet"], c="white", s=40,
           edgecolors="black", zorder=5, label="CFD samples")
ax.set_xlabel("v_inlet (m/s)")
ax.set_ylabel("T_inlet (K)")
ax.set_title(f"Predicted tmax  [{sname_tmax}]")
ax.legend()

plt.tight_layout()
plt.savefig(f"{DATA_DIR}\\response_surface.png", dpi=150)
plt.show()

# ========= 5. 定义多目标优化问题 =========
class CoolingOptProblem(Problem):
    """
    设计变量: x[0]=v_inlet (m/s), x[1]=T_inlet (K)
    目标函数: 最小化 vmax 和 tmax（两个都越小越好）
    约束:     无硬约束，边界由 xl/xu 控制
    """
    def __init__(self, model_vmax, model_tmax):
        super().__init__(
            n_var=2,
            n_obj=2,
            n_ieq_constr=0,
            xl=np.array([V_MIN, T_MIN]),
            xu=np.array([V_MAX, T_MAX])
        )
        self.model_vmax = model_vmax
        self.model_tmax = model_tmax

    def _evaluate(self, x, out, *args, **kwargs):
        f1 = self.model_vmax.predict(x)
        f2 = self.model_tmax.predict(x)
        out["F"] = np.column_stack([f1, f2])

problem = CoolingOptProblem(surrogate_vmax, surrogate_tmax)

# ========= 6. 运行 NSGA-II =========
print("\n" + "="*50)
print("===== NSGA-II 多目标优化 =====")
print("="*50)

algorithm = NSGA2(
    pop_size=100,
    sampling=FloatRandomSampling(),
    crossover=SBX(prob=0.9, eta=15),
    mutation=PM(eta=20),
    eliminate_duplicates=True
)

t0  = time.time()
res = minimize(
    problem,
    algorithm,
    termination=("n_gen", 200),
    seed=42,
    verbose=True
)
print(f"\nNSGA-II 耗时: {time.time()-t0:.2f}s")
print(f"Pareto前沿解的数量: {len(res.X)}")

# ========= 7. 整理Pareto结果 =========
pareto_X = res.X   # shape: (n_pareto, 2)
pareto_F = res.F   # shape: (n_pareto, 2)

pareto_df = pd.DataFrame({
    "v_inlet":   pareto_X[:, 0],
    "T_inlet":   pareto_X[:, 1],
    "vmax_pred": pareto_F[:, 0],
    "tmax_pred": pareto_F[:, 1],
})
pareto_df = pareto_df.sort_values("tmax_pred").reset_index(drop=True)

print("\nPareto前沿（按tmax排序，前10条）:")
print(pareto_df.head(10).to_string(index=False))
pareto_df.to_csv(f"{DATA_DIR}\\pareto_results.csv", index=False)
print(f"\nPareto结果已保存: {DATA_DIR}\\pareto_results.csv")

# ========= 8. 推荐设计点 =========
idx_min_tmax = int(np.argmin(pareto_F[:, 1]))
idx_min_vmax = int(np.argmin(pareto_F[:, 0]))

# 折中：归一化后距离原点最近
F_norm       = (pareto_F - pareto_F.min(axis=0)) / \
               (pareto_F.max(axis=0) - pareto_F.min(axis=0) + 1e-12)
idx_balanced = int(np.argmin(np.linalg.norm(F_norm, axis=1)))

recommend = {
    "最低温度 (Min tmax)":  idx_min_tmax,
    "最低速度 (Min vmax)":  idx_min_vmax,
    "折中方案 (Balanced)":  idx_balanced,
}

print("\n" + "="*50)
print("推荐设计点汇总")
print("="*50)
for label, idx in recommend.items():
    v  = pareto_X[idx, 0]
    T  = pareto_X[idx, 1]
    vm = pareto_F[idx, 0]
    tm = pareto_F[idx, 1]
